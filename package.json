{
  "name": "cheerio-resolve-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "npx tsx src/cli/resolveCli.ts",
    "eval:rules": "npx tsx tools/evaluate_suite.ts --mode rules --split iteration",
    "eval:hybrid": "npx tsx tools/evaluate_suite.ts --mode hybrid --split iteration",
    "eval:smoke": "npx tsx tools/run_laya_smoke.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
